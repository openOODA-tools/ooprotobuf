# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooprotobuf-bin
_pkgname=ooprotobuf
pkgver=0.1.0
pkgrel=1
pkgdesc="Decodes Protocol Buffer wire format without needing compiled proto stubs."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooprotobuf"
license=('Apache-2.0')
depends=('glibc')
provides=('ooprotobuf')
conflicts=('ooprotobuf')
source_x86_64=("${url}/releases/download/v${pkgver}/ooprotobuf-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooprotobuf-linux-x86_64" "${pkgdir}/usr/bin/ooprotobuf"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooprotobuf-uninstall"
}
